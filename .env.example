# provider keys for inferences
FAL_KEY=
OPENROUTER_API_KEY=

# story/series text model (needs OPENROUTER_API_KEY)
STORY_TEXT_PROVIDER=openrouter
STORY_TEXT_MODEL=openai/gpt-4o-mini

# story video render: scene images (needs FAL_KEY), narration (local edge, keyless)
STORY_IMAGE_PROVIDER=fal
STORY_IMAGE_MODEL=fal-ai/flux/schnell
STORY_TTS_PROVIDER=edge
STORY_TTS_VOICE=en-US-AriaNeural

# storage paths
KINOFORGE_SHARED_ROOT=./data/output
CORE_DATA_DIR=./data

# published host ports
CORE_PORT=8000
DASHBOARD_PORT=5173
