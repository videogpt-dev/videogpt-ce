# provider keys for inferences
FAL_KEY=
OPENROUTER_API_KEY=

# managed cloud gateway (provider "cloud"): mint a key in the cloud dashboard (Settings ->
# API Keys) and point at the hosted infrelay. Generations then run on the full cloud roster
# and spend your account's credits. Leave blank to stay fully local.
# When a STORY_*_PROVIDER below is "cloud", set its STORY_*_MODEL to "auto" (the cloud picks
# the default route for that kind) or to a name from the cloud catalog:
#   curl -H "Authorization: Bearer $VIDEOGPT_API_KEY" "$VIDEOGPT_CLOUD_URL/v1/catalog?kind=image"
# A leftover local model id (e.g. fal-ai/flux/schnell) is NOT a valid cloud name and will 404.
VIDEOGPT_API_KEY=
VIDEOGPT_CLOUD_URL=

# story/series text model (needs OPENROUTER_API_KEY)
STORY_TEXT_PROVIDER=openrouter
STORY_TEXT_MODEL=openai/gpt-4o-mini
# max output tokens per write stage; raise if long stories get cut off
#STORY_TOKEN_BUDGET=8000

# story video render: scene images (needs FAL_KEY), narration (local edge, keyless)
STORY_IMAGE_PROVIDER=fal
STORY_IMAGE_MODEL=fal-ai/flux/schnell
STORY_TTS_PROVIDER=edge
#STORY_TTS_VOICE=en-US-AriaNeural
STORY_TTS_VOICE=hi-IN-SwaraNeural

# storage paths
KINOFORGE_SHARED_ROOT=./data/output
CORE_DATA_DIR=./data

# kinoforge console verbosity (per-request; core stamps it on every engine call). error is
# quiet; set debug or trace to trace the full clips/story pipeline in the kinoforge logs.
KINOFORGE_LOG_LEVEL=error

# clip moment finder default when the UI does not pick one. MOMENT_FINDER=auto|ai|offline;
# provider+model resolve the AI route (e.g. cloud/auto, or openrouter/<model-id>). Leave the
# provider/model blank to keep offline unless the UI selects AI.
MOMENT_FINDER=auto
MOMENT_FINDER_PROVIDER=
MOMENT_FINDER_MODEL=

# published host ports
CORE_PORT=8000
DASHBOARD_PORT=5173
