# provider keys
FAL_KEY=
OPENROUTER_API_KEY=

# videogpt.dev cloud: API key from Settings -> API Keys; blank stays fully local
VIDEOGPT_API_KEY=
VIDEOGPT_CLOUD_URL=https://infrelay.videogpt.dev

# story text (provider "videogpt" takes model "auto")
STORY_TEXT_PROVIDER=openrouter
STORY_TEXT_MODEL=openai/gpt-4o-mini
#STORY_TOKEN_BUDGET=8000

# story images and narration
STORY_IMAGE_PROVIDER=fal
STORY_IMAGE_MODEL=fal-ai/flux/schnell
STORY_TTS_PROVIDER=edge
STORY_TTS_VOICE=en-US-AriaNeural

# storage
KINOFORGE_SHARED_ROOT=./data/output
CORE_DATA_DIR=./data

# error, info, debug or trace
KINOFORGE_LOG_LEVEL=error

# moment finder: auto, ai or offline
MOMENT_FINDER=auto
MOMENT_FINDER_PROVIDER=
MOMENT_FINDER_MODEL=

# ports; there is no login, so 0.0.0.0 only behind your own auth
BIND_HOST=127.0.0.1
CORE_PORT=8000
DASHBOARD_PORT=5173
